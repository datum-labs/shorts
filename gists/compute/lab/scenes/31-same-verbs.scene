~ podman run -d --name dcs3-web -p 8081:80 docker.io/library/nginx:1.27-alpine >/dev/null
~ datumctl compute deploy dcs3-web --image=docker.io/library/nginx:1.27-alpine --no-http --location=us-east-1 --runtime-class=general-purpose --yes
~ sleep 5; for i in 1 2 3 4 5 6; do datumctl compute exec dcs3-web-default-us-east-1-0 -- uname -r | grep -q '^6\.' && break; sleep 3; done
$ podman ps --filter name=dcs3 --format '{{.Names}} {{.Status}}'
$ datumctl compute workloads | awk '/dcs3-web/{print $1, $3, $4}'
$ podman logs --tail 2 dcs3-web
$ datumctl compute logs dcs3-web --current --tail=2 --timestamps=false
$ podman exec dcs3-web uname -r
$ datumctl compute exec dcs3-web-default-us-east-1-0 -- uname -r
